{
  "name": "react-dynamic-viewpager",
  "version": "0.2.0",
  "type": "module",
  "description": "dynamic ViewPager component for React",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./ViewPager": {
      "types": "./lib/ViewPager.d.ts",
      "import": "./lib/ViewPager.js",
      "require": "./lib/ViewPager.cjs"
    },
    "./useViewPager": {
      "types": "./lib/useViewPager.d.ts",
      "import": "./lib/useViewPager.js",
      "require": "./lib/useViewPager.cjs"
    },
    "./type": {
      "types": "./lib/type.d.ts",
      "import": "./lib/type.js",
      "require": "./lib/type.cjs"
    }
  },
  "repository": "https://github.com/ushiboy/react-dynamic-viewpager",
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "rm -rf ./lib && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "ushiboy",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "happy-dom": "^17.1.1",
    "prettier": "^3.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.6"
  },
  "packageManager": "pnpm@10.4.0+sha512.6b849d0787d97f8f4e1f03a9b8ff8f038e79e153d6f11ae539ae7c435ff9e796df6a862c991502695c7f9e8fac8aeafc1ac5a8dab47e36148d183832d886dd52",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
